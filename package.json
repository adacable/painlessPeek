{
  "name": "painless-peek",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "build:firefox": "wxt build -b firefox",
    "build:docs": "vite build --config vite.config.docs.ts",
